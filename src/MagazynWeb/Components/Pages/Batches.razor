@page "/partie"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>@Lang.T("Batches")</PageTitle>

<h1>@Lang.T("Batches")</h1>

@if (dispatchError != "")
{
    <div class="alert alert-danger">@dispatchError</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2">
                <input @bind="batchNumber" placeholder="@Lang.T("BatchNo")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="itemId" placeholder="@Lang.T("ItemId")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="quantity" placeholder="@Lang.T("Quantity")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="price" placeholder="@Lang.T("Price")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="date" placeholder="@Lang.T("Date")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="status" placeholder="@Lang.T("Status")" class="form-control" />
            </div>
        </div>
        @if (editedId == 0)
        {
            <button class="btn btn-primary mt-2" @onclick="Add">@Lang.T("Add")</button>
        }
        else
        {
            <button class="btn btn-success mt-2" @onclick="Add">@Lang.T("Save")</button>
            <button class="btn btn-secondary mt-2" @onclick="Cancel">@Lang.T("Cancel")</button>
        }
    </div>
</div>

@if (batches == null)
{
    <p><em>@Lang.T("Loading")</em></p>
}
else
{
    <div class="card">
        <div class="card-body p-0">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>@Lang.T("BatchNo")</th>
                <th>@Lang.T("Item")</th>
                <th>@Lang.T("Quantity")</th>
                <th>@Lang.T("Price")</th>
                <th>@Lang.T("Date")</th>
                <th>@Lang.T("Status")</th>
                <th>@Lang.T("Actions")</th>        
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in batches)
            {
                <tr>
                    <td>@batch.Id</td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.Name</td>
                    <td>@batch.Quantity</td>
                    <td>@batch.Price zł</td>
                    <td>@batch.Date</td>
                    <td>@batch.Status</td>
                    <td>
                        @if (batch.Quantity > 0)
                        {
                            <input type="number" @bind="dispatchQuantity[batch.Id]" style="width:70px" />
                            <button class="btn btn-success btn-sm" @onclick="@(() => Dispatch(batch))">@Lang.T("Dispatch")</button>
                        }
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Delete(batch.Id))">@Lang.T("Delete")</button>
                        <button class="btn btn-outline-warning btn-sm" @onclick="@(() => Edit(batch.Id))">@Lang.T("Edit")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
     </div>
    </div>
}

@code {
    private string batchNumber = "";
    private int itemId;
    private int quantity;
    private decimal price;
    private string date = "";
    private string status = "";
    private string dispatchError = "";
    private int editedId = 0;

    private List<Batch>? batches;
    private Dictionary<int, int> dispatchQuantity = new Dictionary<int, int>();

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Add()
    {
        if (batchNumber == "" || itemId == 0)
        {
            return;
        }

        if (editedId == 0)
        {
            var newBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PostAsJsonAsync("http://localhost:5109/api/Batch", newBatch);
        }
        else
        {
            var editedBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PutAsJsonAsync($"http://localhost:5109/api/Batch/{editedId}", editedBatch);
            editedId = 0;
        }
        await Refresh();
    }

    private async Task Delete(int id)
    {
        await Http.DeleteAsync($"http://localhost:5109/api/Batch/{id}");
        await Refresh();
    }

    private void Edit(int id)
    {
        foreach (var batch in batches)
        {
            if (batch.Id == id)
            {
                batchNumber = batch.BatchNumber;
                itemId = batch.ItemId;
                quantity = batch.Quantity;
                price = batch.Price;
                date = batch.Date;
                status = batch.Status;
                editedId = id;
            }
        }
    }
    private void Cancel ()
    {
        batchNumber = "";
        itemId = 0;
        quantity = 0;
        price = 0;
        date = "";
        status = "";
        editedId = 0;
    }
    private async Task Refresh()
    {
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
        dispatchQuantity = new Dictionary<int, int>();
        foreach (var batch in batches)
        {
            dispatchQuantity[batch.Id] = 0;
        }
    }

    private async Task Dispatch(Batch batch)
    {
        if (dispatchQuantity[batch.Id] <= 0)
        {
            dispatchError = @Lang.T("EnterQuantity");
            return;
        }
        var response = await Http.PostAsJsonAsync("http://localhost:5109/api/Batch/wydanie",
            new { itemId = batch.ItemId, quantity = dispatchQuantity[batch.Id] });
        if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            dispatchError = @Lang.T("NotEnoughStock");
        }
        else if (!response.IsSuccessStatusCode)
        {
            dispatchError = @Lang.T("ServerError");
        }
        else
        {
            dispatchError = "";
        }
        await Refresh();
    }
}
