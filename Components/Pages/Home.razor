@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Magazyn</PageTitle>

<h1>Magazyn</h1>

<input @bind="name" placeholder="Nazwa" />
<input @bind="quantity" placeholder="Ilość" />
<input @bind="price" placeholder="Cena" />
<input @bind="searchName" @bind:event="oninput" placeholder="Szukana nazwa" />

@if (editedId == 0)
{
    <button class="btn btn-primary" @onclick="Dodaj">Dodaj</button>
}
else
{
    <button class="btn btn-success" @onclick="Dodaj">Zapisz</button>
}
@if (items == null) // Wyświetlanie komunikatu ładowania, jeśli przedmioty są null
{
    <p><em>Ładowanie...</em></p>
}
else // Wyświetlanie tabeli z przedmiotami
{
    <table class="table">
        @* Nagłówki tabeli *@
        <thead>
            @* Wiersz z nagłówkami *@
            <tr>
                <th>Id</th>
                <th>Nazwa</th>
                <th>Ilość</th>
                <th>Cena</th>
                <th>Wartość</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items) // Wyświetlanie przedmiotów w tabeli
            {
                @if (searchName == "" || item.Name.Contains(searchName, StringComparison.OrdinalIgnoreCase))
                {
                    @* Wiersz z przedmiotem *@
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price zł</td>
                        <td>@(item.Quantity * item.Price) zł</td>
                        <td>
                            <button class="btn btn-danger" @onclick="@(() => Usun(item.Id))">Usuń</button>
                            <button class="btn btn-warning" @onclick="@(() => Edytuj(item.Id))">Edytuj</button>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
    <p><strong>Wartość magazynu: @totalValue zł</strong></p>
    <p> <strong>Liczba sztuk: @totalQuantity</strong></p>
    <p> <strong>Liczba pozycji: @totalItems</strong></p>
}

@code { // Definicja klasy Przedmiot
    private string name = "";
    private string searchName = "";
    private int quantity;
    private decimal price;
    private int editedId = 0;

    private List<Item>? items;
    private decimal totalValue;
    private int totalQuantity;
    private int totalItems;

    protected override async Task OnInitializedAsync() // Pobieranie przedmiotów z AP
    {
        items = await Http.GetFromJsonAsync<List<Item>>("http://localhost:5109/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }

    private void ObliczWartosc()
    {
        totalValue = 0;
        foreach (var item in items)
        {
            totalValue = totalValue + item.Quantity * item.Price;
        }
    }

    private void ObliczIlosc()
    {
        totalQuantity = 0;
        foreach (var item in items)
        {
            totalQuantity = totalQuantity + item.Quantity;
        }
    }
    private void ObliczIloscPozycji()
    {
        totalItems = 0;
        foreach (var item in items)
        {
            totalItems++;
        }
    }

    private async Task Dodaj()
    {
        bool found = false;

        if (editedId == 0)
        {
            foreach (var item in items)
            {
                if (item.Name == name)
                {
                    var bumped = new Item { Name = item.Name, Quantity = item.Quantity + quantity, Price = item.Price };
                    await Http.PutAsJsonAsync($"http://localhost:5109/api/przedmioty/{item.Id}", bumped);
                    found = true;
                }
            }
            if (found == false)
            {
                var newItem = new Item { Name = name, Quantity = quantity, Price = price };
                await Http.PostAsJsonAsync("http://localhost:5109/api/przedmioty", newItem);
            }
        }
        else
        {
            var editedItem = new Item { Name = name, Quantity = quantity, Price = price };
            await Http.PutAsJsonAsync($"http://localhost:5109/api/przedmioty/{editedId}", editedItem);
            editedId = 0;
        }
        items = await Http.GetFromJsonAsync<List<Item>>("http://localhost:5109/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }
    private async Task Usun(int id) // Usuwanie przedmiot
    {
        await Http.DeleteAsync($"http://localhost:5109/api/przedmioty/{id}");
        items = await Http.GetFromJsonAsync<List<Item>>("http://localhost:5109/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }
    private void Edytuj(int id) // Edytowanie przedmiot
    {
        foreach (var item in items) // Szukanie przedmiotu o podanym id
        {
            if (item.Id == id)
            {
                name = item.Name;
                quantity = item.Quantity;
                price = item.Price;
                editedId = id;
            }
        }
    }
}
