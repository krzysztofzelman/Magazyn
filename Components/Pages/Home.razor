@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Magazyn</PageTitle>

<h1>Magazyn</h1>

<input @bind="nazwa" placeholder="Nazwa" />
<input @bind="ilosc" placeholder="Ilość" />
<input @bind="cena" placeholder="Cena" />
<input @bind="szukanaNazwa" @bind:event="oninput" placeholder="Szukana nazwa" />

@if (edytowanyId == 0)
{
    <button class="btn btn-primary" @onclick="Dodaj">Dodaj</button>
}
else
{
    <button class="btn btn-success" @onclick="Dodaj">Zapisz</button>
}   
@if (przedmioty == null) // Wyświetlanie komunikatu ładowania, jeśli przedmioty są null
{
    <p><em>Ładowanie...</em></p>
}
else // Wyświetlanie tabeli z przedmiotami
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nazwa</th>
                <th>Ilość</th>
                <th>Cena</th>
                <th>Wartość</th>
                <th>Akcje</th>
            </tr>      
        </thead>
        <tbody>
            @foreach (var przedmiot in przedmioty) // Wyświetlanie przedmiotów w tabeli
            {
                @if (szukanaNazwa == "" || przedmiot.Nazwa.Contains(szukanaNazwa, StringComparison.OrdinalIgnoreCase))
                {
                    <tr>
                        <td>@przedmiot.Id</td>
                        <td>@przedmiot.Nazwa</td>
                        <td>@przedmiot.Ilosc</td>
                        <td>@przedmiot.Cena zł</td>
                        <td>@(przedmiot.Ilosc * przedmiot.Cena) zł</td>
                        <td>
                            <button class="btn btn-danger" @onclick="@(() => Usun(przedmiot.Id))">Usuń</button>
                            <button class="btn btn-warning" @onclick="@(() => Edytuj(przedmiot.Id))">Edytuj</button>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
    <p><strong>Wartość magazynu: @wartoscMagazynu zł</strong></p>
    <p> <strong>Liczba sztuk: @iloscSztuk</strong></p>
    <p> <strong>Liczba pozycji: @iloscpozycji</strong></p>
}

@code { // Definicja klasy Przedmiot
    private string nazwa ="";
    private string szukanaNazwa = "";
    private int ilosc;
    private decimal cena;
    private int edytowanyId = 0;
   
    private List<Przedmiot>? przedmioty;
    private decimal wartoscMagazynu;
    private int iloscSztuk;
    private int iloscpozycji;

    protected override async Task OnInitializedAsync() // Pobieranie przedmiotów z AP
    {
        przedmioty = await Http.GetFromJsonAsync<List<Przedmiot>>("http://localhost:5000/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }

    private void ObliczWartosc()
    {
        wartoscMagazynu = 0;
        foreach (var przedmiot in przedmioty)
        {
            wartoscMagazynu = wartoscMagazynu + przedmiot.Ilosc * przedmiot.Cena;
        }
    }

    private void ObliczIlosc()
    {
        iloscSztuk = 0;
        foreach (var przedmiot in przedmioty)
        {
            iloscSztuk = iloscSztuk + przedmiot.Ilosc;
        }
    }
    private void ObliczIloscPozycji()
    {
        iloscpozycji = 0;
        foreach (var przedmiot in przedmioty)
        {
            iloscpozycji++;
        }
    }

    private async Task Dodaj()
    {
        bool znaleziony = false;

        if (edytowanyId == 0)
        {
            foreach (var przedmiot in przedmioty)
            {
                if (przedmiot.Nazwa == nazwa)
                {
                    var podbity = new Przedmiot { Nazwa = przedmiot.Nazwa, Ilosc = przedmiot.Ilosc + ilosc, Cena = przedmiot.Cena };
                    await Http.PutAsJsonAsync($"http://localhost:5000/api/przedmioty/{przedmiot.Id}", podbity);
                    znaleziony = true;
                }
            }
            if (znaleziony == false)
            {
                var nowyPrzedmiot = new Przedmiot { Nazwa = nazwa, Ilosc = ilosc, Cena = cena };
                await Http.PostAsJsonAsync("http://localhost:5000/api/przedmioty", nowyPrzedmiot);
            }
        }
        else
        {
            var edytowany = new Przedmiot { Nazwa = nazwa, Ilosc = ilosc, Cena = cena };
            await Http.PutAsJsonAsync($"http://localhost:5000/api/przedmioty/{edytowanyId}", edytowany);
            edytowanyId = 0;
        }
        przedmioty = await Http.GetFromJsonAsync<List<Przedmiot>>("http://localhost:5000/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }
    private async Task Usun(int id) // Usuwanie przedmiot
    {
        await Http.DeleteAsync($"http://localhost:5000/api/przedmioty/{id}");
        przedmioty = await Http.GetFromJsonAsync<List<Przedmiot>>("http://localhost:5000/api/przedmioty");
        ObliczWartosc();
        ObliczIlosc();
        ObliczIloscPozycji();
    }
    private void Edytuj(int id) // Edytowanie przedmiot
    {
        foreach (var przedmiot in przedmioty) // Szukanie przedmiotu o podanym id
        {
            if (przedmiot.Id == id)
            {
                nazwa = przedmiot.Nazwa;
                ilosc = przedmiot.Ilosc;
                cena = przedmiot.Cena;
                edytowanyId = id;
            }
        }
    }
}