@page "/partie"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Partie</PageTitle>

<h1>Partie</h1>

<input @bind="batchNumber" placeholder="Nr partii" />
<input @bind="itemId" placeholder="Id artykułu" />
<input @bind="quantity" placeholder="Ilość" />
<input @bind="price" placeholder="Cena" />
<input @bind="date" placeholder="Data" />
<input @bind="status" placeholder="Status" />

@if (editedId == 0)
{
    <button class="btn btn-primary" @onclick="Dodaj">Dodaj</button>
}
else
{
    <button class="btn btn-success" @onclick="Dodaj">Zapisz</button>
}

@if (batches == null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nr partii</th>
                <th>Artykuł</th>
                <th>Ilość</th>
                <th>Cena</th>
                <th>Data</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in batches)
            {
                <tr>
                    <td>@batch.Id</td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.Name</td>
                    <td>@batch.Quantity</td>
                    <td>@batch.Price zł</td>
                    <td>@batch.Date</td>
                    <td>@batch.Status</td>
                    <td>
                        <button class="btn btn-danger" @onclick="@(() => Usun(batch.Id))">Usuń</button>
                        <button class="btn btn-warning" @onclick="@(() => Edytuj(batch.Id))">Edytuj</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string batchNumber = "";
    private int itemId;
    private int quantity;
    private decimal price;
    private string date = "";
    private string status = "";
    private int editedId = 0;

    private List<Batch>? batches;

    protected override async Task OnInitializedAsync()
    {
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Dodaj()
    {
        if (editedId == 0)
        {
            var newBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PostAsJsonAsync("http://localhost:5109/api/Batch", newBatch);
        }
        else
        {
            var editedBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PutAsJsonAsync($"http://localhost:5109/api/Batch/{editedId}", editedBatch);
            editedId = 0;
        }
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Usun(int id)
    {
        await Http.DeleteAsync($"http://localhost:5109/api/Batch/{id}");
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private void Edytuj(int id)
    {
        foreach (var batch in batches)
        {
            if (batch.Id == id)
            {
                batchNumber = batch.BatchNumber;
                itemId = batch.ItemId;
                quantity = batch.Quantity;
                price = batch.Price;
                date = batch.Date;
                status = batch.Status;
                editedId = id;
            }
        }
    }
}
