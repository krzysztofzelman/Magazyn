@page "/partie"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>@Lang.T("Batches")</PageTitle>

<h1>@Lang.T("Batches")</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2">
                <input @bind="batchNumber" placeholder="@Lang.T("BatchNo")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="itemId" placeholder="@Lang.T("ItemId")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="quantity" placeholder="@Lang.T("Quantity")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="price" placeholder="@Lang.T("Price")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="date" placeholder="@Lang.T("Date")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="status" placeholder="Status" class="form-control" />
            </div>
        </div>
        @if (editedId == 0)
        {
            <button class="btn btn-primary mt-2" @onclick="Dodaj">@Lang.T("Add")</button>
        }
        else
        {
            <button class="btn btn-success mt-2" @onclick="Dodaj">@Lang.T("Save")</button>
        }
    </div>
</div>

@if (batches == null)
{
    <p><em>@Lang.T("Loading")</em></p>
}
else
{
    <div class="card">
        <div class="card-body p-0">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>@Lang.T("BatchNo")</th>
                <th>@Lang.T("Item")</th>
                <th>@Lang.T("Quantity")</th>
                <th>@Lang.T("Price")</th>
                <th>@Lang.T("Date")</th>
                <th>Status</th>
                <th>@Lang.T("Actions")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in batches)
            {
                <tr>
                    <td>@batch.Id</td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.Name</td>
                    <td>@batch.Quantity</td>
                    <td>@batch.Price zł</td>
                    <td>@batch.Date</td>
                    <td>@batch.Status</td>
                    <td>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Usun(batch.Id))">@Lang.T("Delete")</button>
                        <button class="btn btn-outline-warning btn-sm" @onclick="@(() => Edytuj(batch.Id))">@Lang.T("Edit")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
     </div>
    </div>
}

@code {
    private string batchNumber = "";
    private int itemId;
    private int quantity;
    private decimal price;
    private string date = "";
    private string status = "";
    private int editedId = 0;

    private List<Batch>? batches;

    protected override async Task OnInitializedAsync()
    {
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Dodaj()
    {
        if (batchNumber == "" || itemId == 0)
        {
            return;
        }

        if (editedId == 0)
        {
            var newBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PostAsJsonAsync("http://localhost:5109/api/Batch", newBatch);
        }
        else
        {
            var editedBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PutAsJsonAsync($"http://localhost:5109/api/Batch/{editedId}", editedBatch);
            editedId = 0;
        }
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Usun(int id)
    {
        await Http.DeleteAsync($"http://localhost:5109/api/Batch/{id}");
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private void Edytuj(int id)
    {
        foreach (var batch in batches)
        {
            if (batch.Id == id)
            {
                batchNumber = batch.BatchNumber;
                itemId = batch.ItemId;
                quantity = batch.Quantity;
                price = batch.Price;
                date = batch.Date;
                status = batch.Status;
                editedId = id;
            }
        }
    }
}
