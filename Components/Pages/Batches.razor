@page "/partie"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Partie</PageTitle>

<h1>Partie</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2">
                <input @bind="batchNumber" placeholder="Nr partii" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="itemId" placeholder="Id artykułu" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="quantity" placeholder="Ilość" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="price" placeholder="Cena" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="date" placeholder="Data" class="form-control" />
            </div>
            <div class="col-md-2">
                <input @bind="status" placeholder="Status" class="form-control" />
            </div>
        </div>
        @if (editedId == 0)
        {
            <button class="btn btn-primary mt-2" @onclick="Dodaj">Dodaj</button>
        }
        else
        {
            <button class="btn btn-success mt-2" @onclick="Dodaj">Zapisz</button>
        }
    </div>
</div>

@if (batches == null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <div class="card">
        <div class="card-body p-0">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nr partii</th>
                <th>Artykuł</th>
                <th>Ilość</th>
                <th>Cena</th>
                <th>Data</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in batches)
            {
                <tr>
                    <td>@batch.Id</td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.Name</td>
                    <td>@batch.Quantity</td>
                    <td>@batch.Price zł</td>
                    <td>@batch.Date</td>
                    <td>@batch.Status</td>
                    <td>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => Usun(batch.Id))">Usuń</button>
                        <button class="btn btn-outline-warning btn-sm" @onclick="@(() => Edytuj(batch.Id))">Edytuj</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
     </div>
    </div>
}

@code {
    private string batchNumber = "";
    private int itemId;
    private int quantity;
    private decimal price;
    private string date = "";
    private string status = "";
    private int editedId = 0;

    private List<Batch>? batches;

    protected override async Task OnInitializedAsync()
    {
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Dodaj()
    {
        if (editedId == 0)
        {
            var newBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PostAsJsonAsync("http://localhost:5109/api/Batch", newBatch);
        }
        else
        {
            var editedBatch = new Batch
            {
                BatchNumber = batchNumber,
                ItemId = itemId,
                Quantity = quantity,
                Price = price,
                Date = date,
                Status = status
            };
            await Http.PutAsJsonAsync($"http://localhost:5109/api/Batch/{editedId}", editedBatch);
            editedId = 0;
        }
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private async Task Usun(int id)
    {
        await Http.DeleteAsync($"http://localhost:5109/api/Batch/{id}");
        batches = await Http.GetFromJsonAsync<List<Batch>>("http://localhost:5109/api/Batch");
    }

    private void Edytuj(int id)
    {
        foreach (var batch in batches)
        {
            if (batch.Id == id)
            {
                batchNumber = batch.BatchNumber;
                itemId = batch.ItemId;
                quantity = batch.Quantity;
                price = batch.Price;
                date = batch.Date;
                status = batch.Status;
                editedId = id;
            }
        }
    }
}
